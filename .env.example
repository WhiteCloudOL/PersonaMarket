# 仅为占位说明。运行 pnpm env:init 生成本机随机凭据；不提交 .env。
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
API_PORT=3001
POSTGRES_USER=personamarket_owner
POSTGRES_DB=personamarket
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_APPLICATION_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
DATABASE_URL=postgresql://personamarket_app:CHANGE_ME_APPLICATION_PASSWORD@127.0.0.1:15432/personamarket
MIGRATION_DATABASE_URL=postgresql://personamarket_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:15432/personamarket
TEST_DATABASE_URL=postgresql://personamarket_owner:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:15432/personamarket_test
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:16379/0
APP_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
STATS_HMAC_KEY=REPLACE_WITH_ANOTHER_64_RANDOM_HEX_CHARACTERS
STORAGE_ROOT=REPLACE_WITH_ABSOLUTE_PROJECT_DATA_STORAGE_PATH
CADDY_DOMAIN=localhost
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
QUEUE_NAME=personamarket-system
WORKER_POLL_INTERVAL_MS=1000

# 生产默认关闭注册，配置可用的 TLS SMTP 后再开启
AUTH_REGISTRATION_ENABLED=false
AUTH_SESSION_TTL_SECONDS=86400
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@example.invalid
SMTP_USER=
SMTP_PASSWORD=
