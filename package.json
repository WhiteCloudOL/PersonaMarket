{
  "name": "personamarket",
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "10.34.8"
  },
  "scripts": {
    "build:images": "node scripts/build-images.mjs",
    "dev": "pnpm build:packages && node scripts/dev.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "typecheck": "node scripts/run-turbo.mjs typecheck && tsc --noEmit -p tsconfig.json",
    "test:unit": "pnpm build:packages && vitest run --config vitest.unit.config.ts",
    "test:integration": "node scripts/run-turbo.mjs build --filter=@personamarket/api --filter=@personamarket/worker && node scripts/run-with-env.mjs integration",
    "test:e2e": "pnpm build && node scripts/run-with-env.mjs e2e",
    "test:visual": "pnpm build && node scripts/run-with-env.mjs visual",
    "build": "node scripts/run-turbo.mjs build",
    "build:packages": "node scripts/run-turbo.mjs build --filter=./packages/*",
    "db:generate": "pnpm --filter @personamarket/database db:generate",
    "db:migrate": "pnpm build:packages && node scripts/run-with-env.mjs migrate",
    "api:generate": "node scripts/run-turbo.mjs build --filter=@personamarket/api && tsx scripts/generate-api.ts",
    "api:check": "node scripts/run-turbo.mjs build --filter=@personamarket/api && tsx scripts/generate-api.ts --check",
    "formats:generate": "pnpm --filter @personamarket/contracts build && node scripts/generate-persona-format.mjs",
    "formats:check": "pnpm --filter @personamarket/contracts build && node scripts/generate-persona-format.mjs --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm api:check && pnpm formats:check",
    "verify": "pnpm check && pnpm test:integration && pnpm test:e2e",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "env:init": "node scripts/init-env.mjs",
    "data:prepare": "node scripts/prepare-data.mjs",
    "data:check": "node scripts/check-data-layout.mjs",
    "skills:verify": "node scripts/verify-agent-skills.mjs",
    "deps:check": "node scripts/check-dependencies.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:images": "node scripts/scan-images.mjs",
    "test:recovery": "node scripts/check-recovery.mjs",
    "licenses:generate": "node scripts/generate-license-notices.mjs",
    "admin:create": "pnpm build:packages && node scripts/create-admin.mjs",
    "rankings:rebuild": "pnpm build:packages && node scripts/rebuild-rankings.mjs",
    "test:native": "pnpm build:packages && tsx scripts/check-native.ts",
    "test:compose": "node scripts/check-compose.mjs",
    "test:proxy": "node scripts/check-proxy.mjs",
    "test:remote": "node scripts/run-turbo.mjs build --filter=@personamarket/api --filter=@personamarket/worker && node scripts/run-with-env.mjs remote"
  },
  "dependencies": {
    "@personamarket/api-client": "workspace:*",
    "@personamarket/contracts": "workspace:*",
    "@personamarket/database": "workspace:*",
    "@personamarket/persona-adapters": "workspace:*",
    "@personamarket/server": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@next/eslint-plugin-next": "16.4.3",
    "@personamarket/api": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.9",
    "@types/pg": "8.23.1",
    "@types/yauzl": "3.4.0",
    "bullmq": "6.4.2",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "redis": "6.3.0",
    "semver": "7.8.5",
    "shadcn": "4.22.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  }
}
