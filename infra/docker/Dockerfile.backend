FROM node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.34.8 --activate
COPY . .
RUN pnpm install --frozen-lockfile
ARG PM_API_BUILD_SOURCE
ENV PM_API_BUILD_SOURCE=${PM_API_BUILD_SOURCE}
RUN pnpm build:packages && pnpm --filter @personamarket/api build && pnpm --filter @personamarket/worker build
ARG PACKAGE=@personamarket/api
RUN pnpm --filter ${PACKAGE} deploy --prod /out/app
RUN mkdir -p /runtime-dirs/storage

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e AS runtime
ENV NODE_ENV=production
ENV PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /app
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /usr/local/LICENSE /usr/share/doc/node/LICENSE
COPY --from=build --chown=1000:1000 /out/app .
COPY --from=build --chown=1000:1000 /runtime-dirs/storage /data/storage
COPY --from=build --chown=1000:1000 /workspace/LICENSE ./LICENSE
COPY --from=build --chown=1000:1000 /workspace/docs/THIRD_PARTY_NOTICES.md ./docs/THIRD_PARTY_NOTICES.md
COPY --from=build --chown=1000:1000 /workspace/docs/third-party ./docs/third-party
COPY --from=build --chown=1000:1000 /workspace/scripts/create-admin.mjs /workspace/scripts/runtime.mjs ./scripts/
USER 1000:1000
ENTRYPOINT []
EXPOSE 3001
CMD ["node", "dist/main.js"]
