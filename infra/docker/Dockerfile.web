FROM node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN npm install --global pnpm@10.34.8
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --concurrency=2 --filter=@personamarket/web
RUN mkdir -p /runtime-dirs/cache

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e AS runtime
ENV NODE_ENV=production
ENV PATH=/usr/local/bin:/usr/bin:/bin
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /usr/local/LICENSE /usr/share/doc/node/LICENSE
COPY --from=build --chown=1000:1000 /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=1000:1000 /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=1000:1000 /workspace/apps/web/public ./apps/web/public
COPY --from=build --chown=1000:1000 /runtime-dirs/cache ./apps/web/.next/cache
COPY --from=build --chown=1000:1000 /workspace/LICENSE ./LICENSE
COPY --from=build --chown=1000:1000 /workspace/docs/THIRD_PARTY_NOTICES.md ./docs/THIRD_PARTY_NOTICES.md
COPY --from=build --chown=1000:1000 /workspace/docs/third-party ./docs/third-party
USER 1000:1000
ENTRYPOINT []
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
