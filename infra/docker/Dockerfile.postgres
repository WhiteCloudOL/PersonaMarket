FROM golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS gosu
ADD --checksum=sha256:cd9719b775dbfedae53923c9b0dc792b66d42c51e0b36652ed6f747fbadc0164 https://codeload.github.com/tianon/gosu/tar.gz/refs/tags/1.19 /source.tar.gz
RUN mkdir /source && tar -xzf /source.tar.gz -C /source --strip-components=1
WORKDIR /source
ENV GOTOOLCHAIN=local
COPY infra/docker/collect-go-licenses.sh /collect-go-licenses.sh
RUN go mod download && CGO_ENABLED=0 go build -mod=readonly -trimpath -buildvcs=false -ldflags='-s -w' -o /out/gosu . && sh /collect-go-licenses.sh /out/go-LICENSES.txt

FROM postgres:18.6-alpine@sha256:898c60cb390d1085bc97bdd6a1ae968757421df394b071848b52b1c09c89d6a5
RUN apk add --upgrade --no-cache brotli-libs=1.2.1-r0 libcurl=8.23.0-r0
COPY docs/third-party/curl-COPYING.txt /usr/share/doc/curl/COPYING
COPY --from=gosu /out/gosu /usr/local/bin/gosu
COPY --from=gosu /source/LICENSE /usr/share/doc/gosu/LICENSE
COPY --from=gosu /out/go-LICENSES.txt /usr/share/doc/gosu/go-LICENSES.txt
